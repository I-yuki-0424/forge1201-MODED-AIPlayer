[Unit]
Description=forgeaip RL training: relay between the PC's training groups and the learner's exchange/ (scripts/train/pc.sh)
After=network-online.target

[Service]
EnvironmentFile=%h/projects/forge1201-MODED-AIPlayer/exchange/.train-pc-env
ExecStart=/usr/bin/python3 -I %h/projects/forge1201-MODED-AIPlayer/scripts/train/pc_relay.py %h/projects/forge1201-MODED-AIPlayer/exchange ${PC_BASE} ${PC_SHARD0}
Restart=always
RestartSec=5
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=default.target
